# Create a key on platform.cominty.ai (API keys) and copy your user id from Profile.
COMINTY_API_KEY=sk-cmt-...
COMINTY_USER_ID=user_...

# Optional: point either agent at a custom agent created on platform.cominty.ai (default: the built-in Chat agent).
# AGENT_INTAKE=
# AGENT_RATE_REPLY=
# AGENT_RATE_GUARD=
# AGENT_HANDOFF=

# live (default): every agent call goes to Cominty and costs credit.
# record: reuse a saved answer when there is one, otherwise call Cominty and save it.
# replay: only saved answers, never calls Cominty (free). Saved in backend/var/agent_fixtures/.
# AGENT_MODE=live
