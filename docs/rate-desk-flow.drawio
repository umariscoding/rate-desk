<mxfile host="app.diagrams.net"><diagram name="Rate Desk flow" id="rate-desk-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rate Desk: from a client email to a proposal" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="14" width="900" height="36" as="geometry"/></mxCell><mxCell id="sub" value="A hotel group-sales desk run by four Cominty agents" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5a6773;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="700" height="24" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;1  Salesperson&lt;/b&gt;&lt;br&gt;Pastes the client&amp;#x27;s email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#5B7083;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;2  Intake agent&lt;/b&gt;&lt;br&gt;Reads the email: client,&lt;br&gt;dates, rooms per night" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1E9FF;strokeColor=#3558C8;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;3  Rate Desk&lt;/b&gt;&lt;br&gt;Builds the rate request from&lt;br&gt;a template and a rate grid" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;4  Salesperson&lt;/b&gt;&lt;br&gt;Approves and sends&lt;br&gt;(the only approval)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#5B7083;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;5  Hotel DORM&lt;/b&gt;&lt;br&gt;Clicks Reply all, fills&lt;br&gt;the grid and adds notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1DC;strokeColor=#C77700;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;6  Rate Reader agent&lt;/b&gt;&lt;br&gt;Reads the messy reply:&lt;br&gt;rates, terms, room notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1E9FF;strokeColor=#3558C8;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1210" y="110" width="190" height="88" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;7  Rate Guard agent&lt;/b&gt;&lt;br&gt;Reads the hotel&amp;#x27;s rate&lt;br&gt;rules from the policy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1E9FF;strokeColor=#3558C8;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1210" y="340" width="190" height="88" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;8  Rate Desk&lt;/b&gt;&lt;br&gt;Exact checks: missing rates,&lt;br&gt;short rooms, totals, minimums" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="980" y="340" width="190" height="88" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;9  Anything wrong?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="750" y="328" width="190" height="112" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;10  Rate Desk&lt;/b&gt;&lt;br&gt;Fills the proposal template&lt;br&gt;and checks every number" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="190" height="88" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;11  Cover Email agent&lt;/b&gt;&lt;br&gt;Writes the client&amp;#x27;s&lt;br&gt;cover email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1E9FF;strokeColor=#3558C8;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="290" y="340" width="190" height="88" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;12  Salesperson&lt;/b&gt;&lt;br&gt;Downloads the proposal&lt;br&gt;and sends it to the client" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#5B7083;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="190" height="88" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Rate Desk&lt;/b&gt;&lt;br&gt;Sends ONE correction email,&lt;br&gt;grid pre-filled, automatically" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="750" y="540" width="190" height="88" as="geometry"/></mxCell><mxCell id="kb" value="&lt;b&gt;Cominty knowledge base&lt;/b&gt;&lt;br&gt;Hotel group-sales policy&lt;br&gt;(minimum rates)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#EFE7FF;strokeColor=#6B46C1;strokeWidth=2;fontSize=12;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1210" y="540" width="190" height="88" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;" edge="1" parent="1" source="n9" target="fix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#44505c;fontStyle=1;dashed=1;" edge="1" parent="1" source="kb" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" value="The DORM answers once more with one reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C77700;fontColor=#C77700;fontStyle=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fix" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845.0" y="664"/><mxPoint x="1500" y="664"/><mxPoint x="1500" y="56"/><mxPoint x="1075.0" y="56"/></Array></mxGeometry></mxCell><mxCell id="lg0" value="" style="rounded=1;fillColor=#E8EEF4;strokeColor=#5B7083;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="682" width="22" height="16" as="geometry"/></mxCell><mxCell id="lt0" value="Salesperson" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="88" y="680" width="100" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;fillColor=#FFF1DC;strokeColor=#C77700;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="212" y="682" width="22" height="16" as="geometry"/></mxCell><mxCell id="lt1" value="Hotel" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="680" width="52" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;fillColor=#E1E9FF;strokeColor=#3558C8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="316" y="682" width="22" height="16" as="geometry"/></mxCell><mxCell id="lt2" value="Cominty Managed Agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="344" y="680" width="180" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;fillColor=#E3F3E8;strokeColor=#2F855A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="548" y="682" width="22" height="16" as="geometry"/></mxCell><mxCell id="lt3" value="Rate Desk (plain code)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="576" y="680" width="188" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;fillColor=#EFE7FF;strokeColor=#6B46C1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="788" y="682" width="22" height="16" as="geometry"/></mxCell><mxCell id="lt4" value="Cominty knowledge base" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="816" y="680" width="188" height="20" as="geometry"/></mxCell><mxCell id="note" value="Every AI step runs on Cominty. Everything that must be exact (grids, money, rate rules, the document) is plain code." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="1200" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>